   "source": [
    "# Simpson Compost"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f984bd40",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "\n",
    "def simpson_comp(f, a, b, n):\n",
    "    h = (b-a)/(2*n)\n",
    "    S = f(a)\n",
    "    for i in range(1,n):\n",
    "        x = a + (2*i)*h\n",
    "        S += 2*f(x)\n",
    "    for i in range(0,n):\n",
    "        x = a + (2*i+1)*h\n",
    "        S += 4*f(x)\n",
    "    S += f(b)\n",
    "    S *= h/3\n",
    "    return S"
   ]
  }
